{
  "name": "@laojie/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build --configLoader runner --outDir ../../.vite-cache/web-dist && vite build --config legacy-vite.config.mjs --configLoader runner",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --configLoader runner",
    "test:e2e": "node ../../scripts/run-web-e2e.mjs"
  },
  "dependencies": {
    "@laojie/content-schema": "workspace:*",
    "@laojie/game-engine": "workspace:*",
    "@laojie/report-engine": "workspace:*",
    "@laojie/shared-contracts": "workspace:*",
    "idb": "^8.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^8.0.0",
    "vitest": "^3.2.0"
  }
}
