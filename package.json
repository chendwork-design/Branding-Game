{
  "name": "laojie-brand-game",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @laojie/api --filter @laojie/web dev",
    "start:local": "pnpm --parallel --filter @laojie/api --filter @laojie/web dev",
    "start:v11": "pnpm --filter @laojie/api dev:v11",
    "preview": "pnpm --filter @laojie/web build && node apps/web/static-server.mjs",
    "build": "pnpm -r build",
    "release:build": "pnpm build && node scripts/prepare-v11-runtime.mjs",
    "release:smoke": "node scripts/release-smoke.mjs",
    "formal:storage:smoke": "node scripts/v11-postgres-smoke.mjs",
    "image:build": "docker build --file Dockerfile.api --tag laojie-brand-game:v1.2.0 .",
    "lint": "pnpm -r lint",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --workspace-concurrency=1 -r test",
    "test:unit": "pnpm --filter @laojie/game-engine test && pnpm --filter @laojie/content-schema test && pnpm --filter @laojie/report-engine test",
    "test:integration": "pnpm --filter @laojie/api test:integration",
    "test:e2e": "pnpm --filter @laojie/web test:e2e",
    "test:mobile": "pnpm --filter @laojie/web test:e2e --project=iphone-webkit",
    "test:load": "pnpm --filter @laojie/api test:load",
    "content:validate": "pnpm --filter @laojie/content-schema validate",
    "content:compile": "pnpm --filter @laojie/content-schema compile && pnpm --filter @laojie/content-schema compile:v11",
    "game:simulate": "pnpm --filter @laojie/game-engine simulate",
    "release:check": "pnpm --filter @laojie/game-engine release:v11",
    "release:check:v11": "pnpm --filter @laojie/game-engine release:v11",
    "assets:check:v11": "node scripts/check-v11-assets.mjs",
    "assets:audit:v18": "node scripts/audit-visual-assets.mjs",
    "visual:cache": "node scripts/visual-cache.mjs prepare",
    "visual:cache:check": "node scripts/visual-cache.mjs check",
    "visual:cache:link": "node scripts/visual-cache.mjs link",
    "visual:run": "node scripts/visual-cache.mjs run --",
    "pilot:preflight": "node scripts/pilot-preflight.mjs",
    "db:local:up": "docker compose up -d postgres",
    "db:local:down": "docker compose down",
    "db:migrate": "pnpm --filter @laojie/api db:migrate",
    "db:seed:test": "pnpm --filter @laojie/api db:seed:test",
    "ops:backup": "node scripts/backup.mjs",
    "ops:restore": "node scripts/restore.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.6.0",
    "typescript-eslint": "^8.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
